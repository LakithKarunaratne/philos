# Copy to .env.local and fill in real values. Never commit .env.local.

# Clerk (https://dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Clerk webhook signing secret (Clerk dashboard -> Webhooks -> your endpoint).
# Required by /api/webhooks/clerk to verify deliveries; without it the endpoint
# rejects every request and the `users` mirror falls back to a lazy upsert.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me

# Clerk routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Neon Postgres pooled connection string used by Prisma (lib/prisma.ts,
# prisma.config.ts). Neon console -> Connect -> enable "Connection pooling".
DATABASE_URL=postgresql://user:password@ep-replace-me-pooler.us-east-2.aws.neon.tech/philos?sslmode=require
